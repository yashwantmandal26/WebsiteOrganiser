rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared data collection for WebsiteOrganiser

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['dashbot2001@gmail.com', 'yashwantmandal26@gmail.com'];
    }

    // groups: Anyone can read.
    // Full write/modify access (including delete, rename, or shrinking groups) is reserved for authenticated admins.
    // Public non-admin contributions can add websites/links or new groups, but cannot delete or shrink existing groups.
    match /sharedData/groups {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.keys().hasAll(['data', 'updatedAt'])
        && request.resource.data.data is list
        && (resource == null || request.resource.data.data.size() >= resource.data.data.size())
      );
    }

    // clickCounts: anyone can read/write (click tracking is open for usage ranking)
    match /sharedData/clickCounts {
      allow read: if true;
      allow write: if true;
    }

    // keywordDescriptions: anyone can read/write comments
    match /sharedData/keywordDescriptions {
      allow read: if true;
      allow write: if true;
    }

    // keywordAddedAt: anyone can write timestamp when adding new links (for NEW badge)
    match /sharedData/keywordAddedAt {
      allow read: if true;
      allow write: if true;
    }

    // keywordDeletedStatus: soft deletes and restores are strictly restricted to authenticated admins
    match /sharedData/keywordDeletedStatus {
      allow read: if true;
      allow write: if isAdmin();
    }

    // activityLogs: audit logs contain sensitive GPS & IP data; strictly restricted to authenticated admins
    match /sharedData/activityLogs {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if request.resource.data.keys().hasAll(['action', 'timestamp']);
    }

    // Default fallback
    match /sharedData/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
