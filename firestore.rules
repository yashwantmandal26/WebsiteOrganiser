rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared data collection for WebsiteOrganiser

    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['dashbot2001@gmail.com'];
    }

    // groups: Anyone can read.
    // Full write/modify access (including delete, rename, or shrinking groups) is reserved for authenticated admins.
    // Public non-admin contributions can add data but cannot delete, shrink, or wipe existing groups.
    match /sharedData/groups {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.keys().hasAll(['data', 'updatedAt'])
        && request.resource.data.data is list
        && (resource == null || request.resource.data.data.size() >= resource.data.data.size())
      );
    }

    // clickCounts: anyone can read/write (click tracking is open)
    match /sharedData/clickCounts {
      allow read: if true;
      allow write: if true;
    }

    // keywordDescriptions: anyone can read/write (comments/descriptions are open)
    match /sharedData/keywordDescriptions {
      allow read: if true;
      allow write: if true;
    }

    // keywordAddedAt: anyone can read/write (timestamp tracking is open)
    match /sharedData/keywordAddedAt {
      allow read: if true;
      allow write: if true;
    }

    // keywordDeletedStatus: anyone can read/write (soft deletes)
    match /sharedData/keywordDeletedStatus {
      allow read: if true;
      allow write: if true;
    }

    // activityLogs: anyone can read/write logs (audit logging is open)
    match /sharedData/activityLogs {
      allow read: if true;
      allow write: if true;
    }

    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Default read access for other docs in sharedData
    match /sharedData/{document=**} {
      allow read: if true;
    }
  }
}
